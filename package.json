{
  "name": "hydragraph-mcp",
  "version": "0.1.0",
  "description": "Graph-native code intelligence for MCP, powered by self-hosted HydraDB",
  "type": "module",
  "bin": {
    "hydragraph": "./dist/server.js",
    "hydragraph-index": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx src/server.ts",
    "index": "tsx src/cli.ts",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.3",
    "tree-sitter": "^0.22.4",
    "tree-sitter-python": "^0.23.6",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
